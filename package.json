{
  "name": "lectureflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @lectureflow/backend dev",
    "start": "pnpm --filter @lectureflow/backend start",
    "dev:backend": "pnpm --filter @lectureflow/backend dev",
    "start:backend": "pnpm --filter @lectureflow/backend start",
    "dev:frontend": "pnpm --filter @lectureflow/frontend dev",
    "db:generate": "pnpm --filter @lectureflow/backend db:generate",
    "db:push": "pnpm --filter @lectureflow/backend db:push",
    "db:migrate": "pnpm --filter @lectureflow/backend db:migrate",
    "db:seed": "pnpm --filter @lectureflow/backend db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt"]
  }
}